# Copy to .env and fill in. Loaded by run.sh.

# Required for headless operation. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# D-Major HQ bridge (Gmail / Calendar / ClickUp / Contacts / documents).
# The dmajor-hq api_key, format hq_live_...  Leave blank to run without HQ.
HQ_API_KEY=
HQ_API_URL=https://industry-33.emergent.host

# Optional: port for the web chat (default 8787)
PORT=8787

# Password-protect the web chat (recommended on a public server). Set BOTH to
# enable HTTP Basic auth; leave blank to run open (localhost only).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Calm Desk API key (for the bridge skills). Leave blank if unused.
CALM_DESK_API_KEY=
